<Window x:Class="ChitaiGorod.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация — ЧитайГород" Height="420" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="Images/icon.ico" FontFamily="Segoe UI">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <Image Source="Images/icon.png" Height="70" Margin="0,0,0,15" Stretch="Uniform"/>
            <TextBlock Text="Вход в систему" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Логин:" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginBox" Height="32" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="32" Padding="6" Margin="0,0,0,20"/>

            <Button Content="Войти" Height="36" Background="#23E1EF" FontWeight="Bold" Click="Login_Click" Margin="0,0,0,10"/>
            <Button Content="Войти как гость" Height="34" Click="Guest_Click"/>
        </StackPanel>
    </Grid>
</Window>