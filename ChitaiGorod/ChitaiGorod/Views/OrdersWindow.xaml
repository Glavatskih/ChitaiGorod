<Window x:Class="ChitaiGorod.Views.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказы — ЧитайГород" Height="600" Width="950"
        WindowStartupLocation="CenterScreen" Icon="/Images/icon.ico" FontFamily="Segoe UI">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Список заказов" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Назад к товарам" HorizontalAlignment="Right" Padding="14,6" Click="Back_Click"/>
        </Grid>

        <ListView x:Name="OrdersList" Grid.Row="1" HorizontalContentAlignment="Stretch" MouseDoubleClick="OrdersList_DoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding ArticlesText, StringFormat='Артикул заказа: {0}'}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding StatusName, StringFormat='Статус заказа: {0}'}" Margin="0,3"/>
                                <TextBlock Text="{Binding PickupAddress, StringFormat='Адрес пункта выдачи: {0}'}"/>
                                <TextBlock Text="{Binding OrderDateText, StringFormat='Дата заказа: {0}'}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="#999999" BorderThickness="1,0,0,0" Padding="10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Дата доставки" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DeliveryDateText}" FontSize="15" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="AdminOrderPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Добавить заказ" Padding="16,8" Background="#23E1EF" FontWeight="Bold" Margin="0,0,10,0" Click="AddOrder_Click"/>
            <Button Content="Удалить заказ" Padding="16,8" Click="DeleteOrder_Click"/>
        </StackPanel>
    </Grid>
</Window>