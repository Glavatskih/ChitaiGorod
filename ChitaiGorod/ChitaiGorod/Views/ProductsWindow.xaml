<Window x:Class="ChitaiGorod.Views.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог товаров — ЧитайГород" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" Icon="/Images/icon.ico" FontFamily="Segoe UI">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Images/icon.png" Height="45" Margin="0,0,12,0"/>
                <TextBlock Text="ЧитайГород — Каталог" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="UserFioText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <Button Content="Выйти" Padding="14,6" Click="Logout_Click"/>
            </StackPanel>
        </Grid>

        <WrapPanel x:Name="FilterPanel" Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Margin="0,0,15,5">
                <TextBlock Text="Поиск:" FontSize="12"/>
                <TextBox x:Name="SearchBox" Width="260" Height="30" Padding="5" TextChanged="Filter_Changed"/>
            </StackPanel>
            <StackPanel Margin="0,0,15,5">
                <TextBlock Text="Сортировка:" FontSize="12"/>
                <ComboBox x:Name="SortBox" Width="210" Height="30" SelectionChanged="Filter_Changed" SelectedIndex="0">
                    <ComboBoxItem Content="Без сортировки"/>
                    <ComboBoxItem Content="Цена: по возрастанию"/>
                    <ComboBoxItem Content="Цена: по убыванию"/>
                    <ComboBoxItem Content="Остаток: по возрастанию"/>
                    <ComboBoxItem Content="Остаток: по убыванию"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,15,5">
                <TextBlock Text="Фильтр по скидке:" FontSize="12"/>
                <ComboBox x:Name="DiscountFilterBox" Width="180" Height="30" SelectionChanged="Filter_Changed" SelectedIndex="0">
                    <ComboBoxItem Content="Все диапазоны"/>
                    <ComboBoxItem Content="0–12,99%"/>
                    <ComboBoxItem Content="13–16,99%"/>
                    <ComboBoxItem Content="17% и более"/>
                </ComboBox>
            </StackPanel>
        </WrapPanel>

        <ListView x:Name="ProductsList" Grid.Row="2" HorizontalContentAlignment="Stretch" MouseDoubleClick="ProductsList_DoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="{Binding RowBackground}"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                    <Setter Property="Padding" Value="8"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Source="{Binding DisplayImage}" Width="110" Height="110" Stretch="Uniform"/>

                        <StackPanel Grid.Column="1" Margin="12,0">
                            <TextBlock FontWeight="Bold" FontSize="15">
                                <Run Text="{Binding CategoryName}"/>
                                <Run Text=" | "/>
                                <Run Text="{Binding Name}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4" Foreground="#333333"/>
                            <TextBlock Text="{Binding ManufacturerName, StringFormat='Производитель: {0}'}"/>
                            <TextBlock Text="{Binding SupplierName, StringFormat='Поставщик: {0}'}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Цена: "/>
                                <TextBlock Text="{Binding OldPriceText}" Foreground="Red" TextDecorations="Strikethrough"
                                           Visibility="{Binding OldPriceVisibility}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding FinalPriceText}" FontWeight="Bold" Foreground="Black"/>
                            </StackPanel>
                            <TextBlock Text="{Binding UnitName, StringFormat='Единица измерения: {0}'}"/>
                            <TextBlock Text="{Binding StockQuantity, StringFormat='Количество на складе: {0}'}"/>
                        </StackPanel>

                        <Border Grid.Column="2" BorderBrush="#999999" BorderThickness="1,0,0,0" Padding="10">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Скидка" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Discount, StringFormat='{}{0}%'}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OrdersBtn" Content="Заказы" Padding="16,8" Margin="0,0,10,0" Click="Orders_Click"/>
            <Button x:Name="AddBtn" Content="Добавить товар" Padding="16,8" Margin="0,0,10,0" Background="#23E1EF" FontWeight="Bold" Click="Add_Click"/>
            <Button x:Name="DeleteBtn" Content="Удалить товар" Padding="16,8" Click="Delete_Click"/>
        </StackPanel>
    </Grid>
</Window>