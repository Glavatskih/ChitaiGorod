<Window x:Class="ChitaiGorod.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар — ЧитайГород" Height="640" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Icon="/Images/icon.ico" FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <StackPanel x:Name="IdPanel" Margin="0,0,0,8">
                <TextBlock Text="ID товара:"/>
                <TextBox x:Name="IdBox" IsReadOnly="True" Background="#EEEEEE" Height="28" Padding="4"/>
            </StackPanel>

            <TextBlock Text="Артикул:"/>
            <TextBox x:Name="ArticleBox" Height="28" Padding="4" Margin="0,0,0,8"/>

            <TextBlock Text="Наименование:"/>
            <TextBox x:Name="NameBox" Height="28" Padding="4" Margin="0,0,0,8"/>

            <TextBlock Text="Категория:"/>
            <ComboBox x:Name="CategoryBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28" Margin="0,0,0,8"/>

            <TextBlock Text="Производитель:"/>
            <ComboBox x:Name="ManufacturerBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28" Margin="0,0,0,8"/>

            <TextBlock Text="Поставщик:"/>
            <ComboBox x:Name="SupplierBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28" Margin="0,0,0,8"/>

            <TextBlock Text="Единица измерения:"/>
            <ComboBox x:Name="UnitBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Цена (руб.):"/>
                    <TextBox x:Name="PriceBox" Height="28" Padding="4"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Скидка (%):"/>
                    <TextBox x:Name="DiscountBox" Height="28" Padding="4"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Остаток:"/>
                    <TextBox x:Name="StockBox" Height="28" Padding="4"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Описание:"/>
            <TextBox x:Name="DescBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="4" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <Image x:Name="PreviewImg" Width="120" Height="80" Stretch="Uniform" Margin="0,0,15,0"/>
                <Button Content="Выбрать фото (300x200)" VerticalAlignment="Center" Padding="12,6" Click="SelectPhoto_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Width="120" Height="34" Background="#23E1EF" FontWeight="Bold" Margin="0,0,10,0" Click="Save_Click"/>
                <Button Content="Назад" Width="100" Height="34" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>