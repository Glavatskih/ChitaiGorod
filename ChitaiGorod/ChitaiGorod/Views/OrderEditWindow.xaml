<Window x:Class="ChitaiGorod.Views.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование заказа — ЧитайГород" Height="420" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Icon="/Images/icon.ico" FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock Text="Товар для заказа (при создании):" x:Name="ProductLabel"/>
        <ComboBox x:Name="ProductBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28" Margin="0,0,0,10"/>

        <TextBlock Text="Статус заказа:"/>
        <ComboBox x:Name="StatusBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28" Margin="0,0,0,10"/>

        <TextBlock Text="Пункт выдачи:"/>
        <ComboBox x:Name="PickupBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28" Margin="0,0,0,10"/>

        <TextBlock Text="Дата заказа:"/>
        <DatePicker x:Name="OrderDatePicker" Height="28" Margin="0,0,0,10"/>

        <TextBlock Text="Дата доставки:"/>
        <DatePicker x:Name="DeliveryDatePicker" Height="28" Margin="0,0,0,10"/>

        <TextBlock Text="Код получения:"/>
        <TextBox x:Name="CodeBox" Height="28" Padding="4" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="110" Height="32" Background="#23E1EF" FontWeight="Bold" Margin="0,0,10,0" Click="Save_Click"/>
            <Button Content="Назад" Width="90" Height="32" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>